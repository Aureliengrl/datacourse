# =====================================================================
# Configuration du Bot Parquet CAC 40
# =====================================================================
# IMPORTANT : NE JAMAIS COMMETTRE VOTRE FICHIER .env AVEC VOS IDENTIFIANTS

# 1. Supabase API Configuration
SUPABASE_URL=https://tsztojpbwiwlluheoyos.supabase.co
SUPABASE_KEY=sb_publishable_UoPH4BSZJkSd9f_YBxzPpg_2ZopR2OA

# 2. Identifiants Étudiant
ETUDIANT_EMAIL=votre_email@etudiant.fr
ETUDIANT_PASSWORD=votre_mot_de_passe

# 3. Paramètres d'exécution
# Passer DRY_RUN à false uniquement quand vous souhaitez activer les vrais ordres d'achat/vente
DRY_RUN=true

# Fréquence / Boucle de surveillance (en secondes si le polling de secours est utilisé)
FALLBACK_POLL_INTERVAL=60

# 4. Paramètres de la Stratégie Quantitative
LOOKBACK_PERIOD=20            # ~20 relevés (~2 jours de bourse) pour le calcul du momentum
MAX_STOCK_WEIGHT=0.15         # 15% maximum de la valeur totale par action
MAX_SECTOR_WEIGHT=0.30        # 30% maximum par secteur GICS
MIN_CASH_BUFFER=0.05          # 5% minimum en liquidités (coussin de sécurité)
STOP_LOSS_THRESHOLD=0.10      # Stop loss à -10% sous le PRU
REBALANCE_THRESHOLD=0.03      # Écart minimal de 3 points de pourcentage requis pour rééquilibrer (limite les frais)

# 5. Alertes & Webhooks (Optionnel)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
